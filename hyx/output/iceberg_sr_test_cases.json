      "reason": "Iceberg(source) <-> StarRocks(processor/sink) 双向数据流"
    },
    
    "component_roles": {
      "Iceberg": {"roles": ["source", "sink"], "type": "data_lake"},
      "StarRocks": {"roles": ["source", "processor", "sink"], "type": "database"}
