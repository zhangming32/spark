          "expected_result": {
            "threshold_ms": 200,
            "baseline": {"agg_time_ms": 100}
          }
        }
      ]
    },
    
    "data_requirements": {
      "log_data_schema": {
        "timestamp": {"type": "date", "format": "ISO8601", "example": "2024-01-15T10:30:00Z"},
        "level": {"type": "keyword", "values": ["ERROR", "WARN", "INFO", "DEBUG"]},
        "message": {"type": "text", "length": "10-500 chars"},
        "service": {"type": "keyword", "values": ["user-service", "order-service", "payment-service", "api-gateway"]},
        "host": {"type": "keyword", "values": ["server-01", "server-02", "server-03"]}
      },
      "data_sizes": {
        "small": {"docs": 100, "purpose": "功能测试"},
        "medium": {"docs": 10000, "purpose": "集成/性能测试"},
        "large": {"docs": 100000, "purpose": "性能测试"}
      }
    },
    
    "environment_requirements": {
      "elasticsearch": {
        "version": "8.x",
        "nodes": 1,
        "port": 9200,
        "config": {
          "cluster.name": "test_cluster",
          "discovery.type": "single-node"
        }
      }
    }
  }
}