          }
        },
        {
          "case_id": "TC_ES_PERF_002",
          "case_name": "中等数据量索引性能",
          "component": "Elasticsearch",
          "priority": "P3",
          "data_size": "medium",
          "docs": 10000,
          "description": "测试批量索引10000条日志的性能",
          "expected_result": {
            "threshold_ms": 5000,
            "baseline": {"bulk_time_ms": 3000}
          }
        },
        {
          "case_id": "TC_ES_PERF_003",
          "case_name": "搜索查询性能",
          "component": "Elasticsearch",
          "priority": "P3",
          "data_size": "medium",
          "docs": 10000,
          "description": "测试在10000条日志中搜索的性能",
          "expected_result": {
            "threshold_ms": 100,
            "baseline": {"search_time_ms": 50}
          }
        },
        {
          "case_id": "TC_ES_PERF_004",
          "case_name": "聚合分析性能",
          "component": "Elasticsearch",
          "priority": "P3",
          "data_size": "medium",
          "docs": 10000,
