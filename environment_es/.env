# Elasticsearch环境配置

# Elasticsearch版本
ES_VERSION=8.12.0
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:${ES_VERSION}

# Kibana版本
KIBANA_VERSION=8.12.0
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:${KIBANA_VERSION}

# 集群配置
ES_CLUSTER_NAME=test_cluster
ES_NODE_NAME=node-1
ES_DISCOVERY_TYPE=single-node

# 安全配置
XPACK_SECURITY_ENABLED=false

# 内存配置
ES_JAVA_OPTS=-Xms1g -Xmx1g

# 端口配置
ES_PORT=9200
ES_TRANSPORT_PORT=9300
KIBANA_PORT=5601

# 测试数据
TEST_DATA_DIR=./test_data/es_logs

# 网络
NETWORK_NAME=test-network